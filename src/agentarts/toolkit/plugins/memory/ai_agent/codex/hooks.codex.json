{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "statusMessage": "agentarts-memory: checking server health"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/prompt-submit.mjs\"",
            "statusMessage": "agentarts-memory: recording prompt + searching memories"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/post-tool-use.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/pre-compact.mjs\"",
            "statusMessage": "agentarts-memory: injecting context before compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTARTS_MEMORY_PLATFORM=codex node \"${CODEX_PLUGIN_ROOT}/scripts/stop.mjs\""
          }
        ]
      }
    ]
  }
}
